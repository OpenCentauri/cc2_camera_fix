# Python cache and local tooling state
__pycache__/
*.py[cod]
.pytest_cache/

# Raw flash images and generated recovery artifacts may contain device-specific
# data such as serial numbers. Keep them out of source control by default.
*.bin
*.rom
*.img
*.zip
*-cc2-recovery/

# Common editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*~
